# Copy this file to .env and replace every value. Never commit .env.

# mysql+pymysql://<user>:<password>@<host>:<port>/<database>
# Percent-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=mysql+pymysql://noteshare_user:CHANGE_ME@localhost:3306/noteshare

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Relative paths are resolved against the project folder.
UPLOAD_FOLDER=uploads

# Set to true in production behind HTTPS. Keep false for local http:// development,
# otherwise the browser will not send the session cookie and logins will not stick.
SESSION_COOKIE_SECURE=false

# Public address once the site has a domain, e.g. https://notes.example.edu (no trailing slash).
# Leave empty for local development.
SITE_URL=

# Separate database used only by the automated tests (python -m pytest).
# Its name must end in "_test"; the tests delete every row in it.
TEST_DATABASE_URL=mysql+pymysql://noteshare_user:CHANGE_ME@localhost:3306/noteshare_test
